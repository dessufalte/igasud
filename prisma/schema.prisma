// Prisma schema for Igasud Studio (igasud.tech) — Multi-Schema Isolated PostgreSQL

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["igasud"]
}

model SiteProfile {
  id           String   @id @default("default")
  name         String   @default("Igasud Studio")
  role         String   @default("Systems Lab for Game Engines & Deterministic AI")
  roleId       String   @default("Laboratorium Sistem untuk Engine Game & AI Deterministik")
  university   String   @default("Nubian · Thema · Deterministic AI Architecture")
  statusText   String   @default("Engine Core v2.0 · Deterministic Runtime Active")
  statusTextId String   @default("Engine Core v2.0 · Runtime Deterministik Aktif")
  about        String   @db.Text
  aboutId      String   @default("") @db.Text
  phone        String   @default("+62 812 3456 7890")
  email        String   @default("hello@igasud.tech")
  linkedin     String   @default("https://linkedin.com/company/igasud-studio")
  github       String   @default("https://github.com/dessulfate")
  forumUrl     String   @default("https://forum.igasud.tech")
  updatedAt    DateTime @updatedAt

  @@schema("igasud")
}

model Project {
  id            String   @id @default(cuid())
  numId         Int      @default(1)
  slug          String   @unique
  title         String
  titleId       String   @default("")
  tagline       String
  taglineId     String   @default("")
  description   String   @db.Text
  descriptionId String   @default("") @db.Text
  category      String
  year          String   @default("2026")
  role          String   @default("Core Systems & Engine Architecture")
  status        String   @default("shipped")
  featured      Boolean  @default(true)
  thumbnail     String   @default("/projects/aurora-design-system.png")
  accent        String   @default("#5c0707")
  techStack     String   @db.Text
  links         String?  @db.Text
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  docs          Doc[]

  @@schema("igasud")
}

model Doc {
  id        String   @id @default(cuid())
  projectId String
  section   String
  icon      String   @default("FileText")
  order     Int      @default(0)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@schema("igasud")
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  body      String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@schema("igasud")
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  body        String   @db.Text
  tag         String   @default("Writing")
  readingMins Int      @default(3)
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("igasud")
}
